generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  PESERTA
}

enum ApplicationStatus {
  DIAJUKAN
  DALAM_VERIFIKASI
  PERLU_PERBAIKAN
  DITERIMA
  DITOLAK
  DIBATALKAN
}

enum DocumentCategory {
  PENGAJUAN
  SURAT
  PENYELESAIAN
  ADMINISTRASI
}

enum CompletionStatus {
  DIAJUKAN
  DISETUJUI
  PERLU_PERBAIKAN
  DITOLAK
}

enum LetterType {
  PENERIMAAN
  SELESAI
}

enum RejectionCategory {
  KUOTA_PENUH
  LAINNYA
}

// Profil aplikasi untuk pengguna Supabase Auth. `id` sama persis dengan
// auth.users.id (dikelola Supabase Auth, bukan Prisma) — password, undangan,
// dan reset password ditangani sepenuhnya oleh Supabase Auth.
model User {
  id        String   @id @db.Uuid
  email     String   @unique
  role      Role     @default(PESERTA)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  application   Application? @relation("UserApplication")
  applicationId String?      @unique

  roomSchedules       RoomSchedule[]
  completionRequests  CompletionRequest[]
  letters             Letter[]
  uploadedDocuments   Document[]           @relation("UploadedByUser")
  auditLogs           AuditLog[]
}

model Division {
  id           String        @id @default(cuid())
  name         String        @unique
  applications Application[]
}

model Application {
  id             String            @id @default(cuid())
  nomorPengajuan String            @unique
  status         ApplicationStatus @default(DIAJUKAN)

  // data pribadi
  namaLengkap  String
  email        String
  telepon      String
  alamat       String?
  tanggalLahir DateTime?

  // data pendidikan
  institusi     String
  fakultas      String?
  programStudi  String?
  nimNis        String?
  semesterKelas String?

  // data magang
  jenisMagang      String?
  rencanaMulai     DateTime
  rencanaSelesai   DateTime
  durasi           String?
  divisiId         String?
  divisi           Division? @relation(fields: [divisiId], references: [id])
  catatan          String?
  nomorSuratAsal   String?
  tanggalSuratAsal DateTime?

  // keputusan admin
  catatanAdmin           String?
  alasanTolak            String?
  alasanTolakKategori    RejectionCategory?
  dokumenPerluDiperbaiki String[]           @default([])
  decidedAt              DateTime?
  decidedById            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents          Document[]
  completionRequests CompletionRequest[]
  letters            Letter[]

  user   User?   @relation("UserApplication", fields: [userId], references: [id])
  userId String? @unique @db.Uuid
}

model Document {
  id         String           @id @default(cuid())
  category   DocumentCategory
  type       String
  fileName   String
  storedPath String
  mimeType   String
  size       Int

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])

  uploadedById String? @db.Uuid
  uploadedBy   User?   @relation("UploadedByUser", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

model Room {
  id        String         @id @default(cuid())
  name      String         @unique
  schedules RoomSchedule[]
}

model RoomSchedule {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id])
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id])
  date   DateTime

  createdAt DateTime @default(now())

  // Menutup race condition di level database: cek konflik di route.ts
  // (findFirst lalu create) masih rawan TOCTOU kalau dua request dieksekusi
  // benar-benar bersamaan -- constraint ini yang jadi jaminan akhir.
  @@unique([roomId, date])
  @@unique([userId, date])
}

model CompletionRequest {
  id            String           @id @default(cuid())
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id])
  userId        String           @db.Uuid
  user          User             @relation(fields: [userId], references: [id])
  status        CompletionStatus @default(DIAJUKAN)
  note          String?
  adminNote     String?
  submittedAt   DateTime         @default(now())
  decidedAt     DateTime?
}

model Letter {
  id     String     @id @default(cuid())
  type   LetterType
  number String     @unique
  date   DateTime   @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  userId        String?     @db.Uuid
  user          User?       @relation(fields: [userId], references: [id])

  pdfPath   String
  createdAt DateTime @default(now())
}

model EmailLog {
  id            String   @id @default(cuid())
  to            String
  subject       String
  body          String
  type          String
  status        String   @default("SENT")
  applicationId String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())
}

// Jendela geser sederhana berbasis DB untuk rate limiting endpoint publik
// (pendaftaran, cek status). Baris lama dibersihkan otomatis saat dicek.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// Log error tak tertangani dari API route untuk dipantau admin, sebagai
// pengganti ringan layanan monitoring pihak ketiga.
model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  stack     String?
  path      String?
  method    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Pengaturan aplikasi yang bisa diubah admin lewat UI tanpa perlu redeploy
// (mis. email balasan resmi instansi), disimpan sebagai key-value sederhana.
model AppSetting {
  key   String @id
  value String
}

// Isi email notifikasi (subjek+body) yang bisa diedit admin lewat Pengaturan >
// Email tanpa perlu ubah kode -- kalau baris untuk suatu `type` belum ada,
// sistem pakai teks default bawaan (lihat lib/emailTemplates.ts).
model EmailTemplate {
  type      String   @id
  subject   String?
  body      String
  updatedAt DateTime @updatedAt
}

// Counter atomik untuk penomoran (nomor pengajuan, nomor surat per tipe+tahun).
// Increment dilakukan lewat satu statement SQL (lihat lib/nomor.ts), bukan
// via Prisma Client, supaya tabrakan antar request bersamaan tidak mungkin
// terjadi di level database.
model NumberCounter {
  id    String @id
  value Int    @default(0)
}
