# Transaction-mode pooler (IPv4, port 6543) — dipakai Prisma Client saat runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler (IPv4, port 5432) — dipakai khusus untuk migrasi/db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

ADMIN_EMAIL="admin@balailayananperpustakaan.go.id"
ADMIN_PASSWORD="Admin123!"

# Gmail SMTP untuk notifikasi email sungguhan (butuh App Password, bukan password akun biasa)
GMAIL_USER="akun-pengirim@gmail.com"
GMAIL_APP_PASSWORD="xxxxxxxxxxxxxxxx"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
